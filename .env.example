# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to GitHub.

# Your Ollama Cloud API key (get one at https://ollama.com)
OLLAMAAPIKEY=your_ollama_cloud_api_key_here

# The Ollama Cloud model to use (e.g. a Qwen model)
OLLAMA_MODEL=qwen2.5

# Optional: Ollama Cloud host (defaults to https://ollama.com if unset)
OLLAMA_HOST=https://ollama.com
